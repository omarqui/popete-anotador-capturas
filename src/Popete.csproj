<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF no soporta AOT -->
    <PublishAot>false</PublishAot>
    <!-- WPF y WinForms juntos generan ambigüedades: los usings están en GlobalUsings.cs,
         y WinForms / System.Drawing se escriben siempre con el nombre completo. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- La UI se construye en código: no recoger .xaml ni .resx sueltos. -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <!-- Ícono del .exe. Se genera desde assets\popete.svg con tools\generar-icono.ps1 -->
    <ApplicationIcon>..\assets\popete.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- El mismo ícono, embebido para la bandeja y las ventanas -->
    <EmbeddedResource Include="..\assets\popete.ico" LogicalName="popete.ico" />
  </ItemGroup>

</Project>
