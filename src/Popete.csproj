<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Con versión de Windows para usar la API StartupTask (inicio con Windows dentro del MSIX) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF no soporta AOT -->
    <PublishAot>false</PublishAot>
    <!-- WPF y WinForms juntos generan ambigüedades: los usings están en GlobalUsings.cs,
         y WinForms / System.Drawing se escriben siempre con el nombre completo. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- La UI se construye en código: no recoger .xaml ni .resx sueltos. -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <!-- Ícono del .exe. Se genera desde assets\popete.svg con tools\generar-icono.ps1 -->
    <ApplicationIcon>..\assets\popete.ico</ApplicationIcon>
    <!-- PerMonitorV2: cada monitor con su escala (la captura en el lugar necesita píxeles exactos) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 pide fijar el DPI con Application.SetHighDpiMode de WinForms, pero la app es de WPF:
         WinForms solo pone la bandeja, y el modo del proceso lo da el manifiesto. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- El mismo ícono, embebido para la bandeja y las ventanas -->
    <EmbeddedResource Include="..\assets\popete.ico" LogicalName="popete.ico" />
    <!-- Las novedades de esta versión, por si la Store no responde (WhatsNewWindow) -->
    <EmbeddedResource Include="..\novedades.txt" LogicalName="novedades.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- La lógica pura de Ideas.cs se prueba desde tests\Popete.Tests -->
    <InternalsVisibleTo Include="Popete.Tests" />
  </ItemGroup>

</Project>
